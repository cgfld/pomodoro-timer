{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local Tomodo window: accounts, notifications, and billing links.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "deep-link:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://tomodo.app/api/*"
        },
        {
          "url": "https://wnqhzpkcpricgnzayspy.supabase.co/auth/v1/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://checkout.stripe.com/**"
        },
        {
          "url": "https://billing.stripe.com/**"
        }
      ]
    }
  ]
}
